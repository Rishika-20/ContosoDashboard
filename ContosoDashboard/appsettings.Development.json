{
  "AzureWebJobsStorage": "UseDevelopmentStorage=true",
  "DocumentQueue": "document-scans",
  "DocumentUpload": {
    "LocalRoot": "AppData/uploads",
    "UseLocalScanWorker": true,
    "LocalScanMaxAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
