@page "/documents"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthState

<PageTitle>Documents</PageTitle>
<h3>Documents</h3>

<div class="card mb-3 p-3">
    <h5>Upload documents</h5>
    <div class="row g-2">
        <div class="col-md-3"><label for="document-title">Title</label><input id="document-title" class="form-control" @bind="title" maxlength="255" /></div>
        <div class="col-md-2">
            <label for="document-category">Category</label>
            <select id="document-category" class="form-select" @bind="category">
                @foreach (var value in DocumentValidation.Categories.OrderBy(x => x)) { <option value="@value">@value</option> }
            </select>
        </div>
        <div class="col-md-4"><label for="document-files">Files (25 MB max each)</label><InputFile id="document-files" OnChange="OnFiles" multiple accept=".pdf,.docx,.xlsx,.pptx,.txt,.jpg,.jpeg,.png" /></div>
        <div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary" @onclick="UploadAsync" disabled="@uploading">@(uploading ? "Uploading…" : "Upload")</button></div>
    </div>
    @if (uploading)
    {
        <div class="mt-2" role="status">Uploading @processedFiles of @selected.Count files…</div>
        <progress class="w-100" max="@Math.Max(1, selected.Count)" value="@processedFiles"></progress>
    }
    @foreach (var message in messages) { <div class="mt-2">@message</div>; }
    @foreach (var result in uploadResults)
    {
        <div class="mt-2">
            @result.OriginalFileName: @result.Status — @result.Message
            @if (result.DocumentId.HasValue) { <a class="ms-2" href="/documents/@result.DocumentId">View scan status</a> }
        </div>
    }
    @if (selected.Count > 0) { <p class="small text-muted mt-2">Only files that failed are retained for retry: @string.Join(", ", selected.Select(f => f.Name))</p>; }
</div>

<div class="card mb-3 p-3">
    <h5>Find documents</h5>
    <div class="row g-2">
        <div class="col-md-3"><label for="document-search">Search</label><input id="document-search" class="form-control" @bind="searchText" placeholder="Title, description, tag, uploader, project" /></div>
        <div class="col-md-2"><label for="filter-category">Category</label><select id="filter-category" class="form-select" @bind="filterCategory"><option value="">All</option>@foreach (var value in DocumentValidation.Categories.OrderBy(x => x)) { <option value="@value">@value</option> }</select></div>
        <div class="col-md-2"><label for="sort-documents">Sort</label><select id="sort-documents" class="form-select" @bind="sortBy"><option value="date">Newest</option><option value="date-asc">Oldest</option><option value="title">Title</option><option value="category">Category</option><option value="size">File size</option></select></div>
        <div class="col-md-2"><label for="filter-from">From</label><InputDate id="filter-from" class="form-control" @bind-Value="fromDate" /></div>
        <div class="col-md-2"><label for="filter-to">To</label><InputDate id="filter-to" class="form-control" @bind-Value="toDate" /></div>
        <div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary" @onclick="LoadDocumentsAsync">Apply</button></div>
    </div>
</div>

<h5>My Documents</h5>
<div class="table-responsive">
    <table class="table">
        <thead><tr><th>Title</th><th>Category</th><th>Uploaded</th><th>Size</th><th>Project</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var d in mine)
            {
                <tr>
                    <td><a href="/documents/@d.DocumentId">@d.Title</a></td><td>@d.Category</td>
                    <td>@d.UploadDateUtc.ToLocalTime().ToString("g")</td><td>@d.FileSizeBytes.ToString("N0") bytes</td>
                    <td>@(d.Project?.Name ?? "Personal")</td><td>@d.ScanStatus</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<h5>Search results</h5>
@foreach (var d in searchResults) { <div><a href="/documents/@d.DocumentId">@d.Title</a> <span class="text-muted">(@d.Category)</span></div> }
<h5 class="mt-3">Shared with Me</h5>
@foreach (var d in shared) { <div><a href="/documents/@d.DocumentId">@d.Title</a></div> }

@code {
    private string title = "";
    private string category = "General";
    private string? searchText;
    private string? filterCategory;
    private string sortBy = "date";
    private DateTime? fromDate;
    private DateTime? toDate;
    private IReadOnlyList<IBrowserFile> selected = Array.Empty<IBrowserFile>();
    private IReadOnlyList<Document> mine = Array.Empty<Document>();
    private IReadOnlyList<Document> shared = Array.Empty<Document>();
    private IReadOnlyList<Document> searchResults = Array.Empty<Document>();
    private readonly List<string> messages = new();
    private IReadOnlyList<UploadResult> uploadResults = Array.Empty<UploadResult>();
    private bool uploading;
    private int processedFiles;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentsAsync();
    }

    private async Task OnFiles(InputFileChangeEventArgs e) => selected = e.GetMultipleFiles(20).ToList();

    private async Task LoadDocumentsAsync()
    {
        var userId = await CurrentUserId();
        if (userId <= 0) return;
        mine = await DocumentService.MineAsync(userId, sortBy, filterCategory, from: fromDate, to: toDate);
        shared = await DocumentService.SharedAsync(userId);
        searchResults = string.IsNullOrWhiteSpace(searchText)
            ? Array.Empty<Document>()
            : await DocumentService.SearchAsync(userId, searchText, filterCategory, null, fromDate, toDate);
    }

    private async Task UploadAsync()
    {
        if (uploading || selected.Count == 0) return;
        uploading = true;
        processedFiles = 0;
        messages.Clear();
        uploadResults = Array.Empty<UploadResult>();
        var retryFiles = new List<IBrowserFile>();
        var files = new List<UploadFile>();
        var sourceFiles = new List<IBrowserFile>();
        foreach (var file in selected)
        {
            if (file.Size < 1 || file.Size > DocumentValidation.MaxFileSizeBytes)
            {
                messages.Add($"{file.Name}: file must be between 1 byte and 25 MB.");
                retryFiles.Add(file);
                processedFiles++;
                await InvokeAsync(StateHasChanged);
                continue;
            }
            try
            {
                await using var ms = new MemoryStream();
                await file.OpenReadStream(DocumentValidation.MaxFileSizeBytes).CopyToAsync(ms);
                files.Add(new UploadFile(ms.ToArray(), file.Name, file.ContentType));
                sourceFiles.Add(file);
            }
            catch (Exception ex) when (ex is IOException or InvalidOperationException)
            {
                messages.Add($"{file.Name}: could not read the selected file.");
                retryFiles.Add(file);
            }
            processedFiles++;
            await InvokeAsync(StateHasChanged);
        }

        var userId = await CurrentUserId();
        if (userId > 0 && files.Count > 0)
        {
            try
            {
                var results = await DocumentService.UploadAsync(userId,
                    new UploadRequest(title, null, category, null, null, null), files);
                uploadResults = results;
                for (var index = 0; index < results.Count; index++)
                {
                    var result = results[index];
                    if (!result.Success) messages.Add($"{result.OriginalFileName}: {result.Message}");
                }
                retryFiles.AddRange(UploadRetryPolicy.FailedFiles(sourceFiles, results));
            }
            catch (Exception)
            {
                messages.Add("Upload could not be completed. Retry the files after checking the connection.");
                retryFiles.AddRange(sourceFiles);
            }
        }
        selected = retryFiles;
        await LoadDocumentsAsync();
        uploading = false;
    }

    private async Task<int> CurrentUserId()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return int.TryParse(state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId)
            ? userId : 0;
    }
}
